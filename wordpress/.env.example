# Kivantos WordPress REST API — site building (Application Passwords)
# Copy to wordpress/.env (gitignored via repo root .env rule) or export in your shell.
# Do not commit real secrets.

WORDPRESS_URL=https://kivantos.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Optional overrides
# WORDPRESS_API_BASE=https://kivantos.com/wp-json
# WORDPRESS_USER_AGENT=KivantosWPClient/0.1
